# Skopiuj ten plik do lab.env i uzupełnij własnymi wartościami:
#   cp lab.env.example lab.env
# Plik lab.env jest w .gitignore – nie trafi do repozytorium.

# Interfejs sieciowy maszyn wirtualnych (sprawdź poleceniem: ip a)
IFACE=ens33

# Stałe adresy IP maszyn wirtualnych
MASTER_IP=192.168.1.51
WORKER1_IP=192.168.1.52
WORKER2_IP=192.168.1.53
MONITORING_IP=192.168.1.54

# Sieć, z której łączysz się do laboratorium (Twój komputer)
ADMIN_CIDR=192.168.1.0/24

# Kanał instalacji k3s (stable / latest / konkretna wersja, np. v1.31)
K3S_CHANNEL=stable

# Token do dołączania workerów – uzupełnij po instalacji mastera
# (wyświetla go skrypt 01-install-master.sh)
K3S_TOKEN=

# Opcjonalnie: przypięta wersja chartu kube-prometheus-stack (puste = najnowsza)
KPS_CHART_VERSION=

# Hasło administratora Grafany (w klastrze i na maszynie monitoring)
GRAFANA_ADMIN_PASSWORD=zmien-to-haslo

# Adres pingu z https://healthchecks.io – odbiera alert Watchdog (dead man's switch)
HEALTHCHECKS_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Firewall ufw na węzłach (yes/no)
ENABLE_UFW=yes
